<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#b3f9ff">

    <!-- Imagen rectangular ocupando todo el ancho arriba del todo -->
    <ImageView
        android:id="@+id/ivAppLogo"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:src="@drawable/educar_logo"
        android:contentDescription="Logo de Educar"
        android:scaleType="centerCrop"/>

    <!-- Contenedor inferior con el padding para los campos y botones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:paddingTop="28dp">

        <!-- Subtítulo para dar contexto -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DEBES HACER LOGIN PARA CONTINUAR..."
            android:textSize="15sp"
            android:textColor="#007FFF"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.08"
            android:layout_marginBottom="36dp" />

        <!-- Campo para introducir el usuario -->
        <EditText
            android:id="@+id/etUsername"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Usuario"
            android:inputType="textPersonName"
            android:paddingHorizontal="16dp"
            android:textColor="#111827"
            android:textColorHint="#9CA3AF"
            android:layout_marginBottom="16dp"
            android:background="#FFFFFF"/>

        <!-- Campo para introducir la contraseña -->
        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Contraseña"
            android:inputType="textPassword"
            android:paddingHorizontal="16dp"
            android:textColor="#111827"
            android:textColorHint="#9CA3AF"
            android:layout_marginBottom="28dp"
            android:background="#FFFFFF"/>

        <!-- Botón de acceder -->
        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Acceder"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#03e8fc"
            android:textColor="#FFFFFF" />

    </LinearLayout>

</LinearLayout>